# TEMPLATE — jangan commit file ini dengan nilai asli
# Buat secret asli dengan salah satu cara:
#
# Cara 1 — kubectl apply:
#   cp 02-secret.yaml.example 02-secret.yaml
#   # edit 02-secret.yaml, isi nilai asli
#   kubectl apply -f 02-secret.yaml
#   rm 02-secret.yaml  # hapus setelah apply, JANGAN commit
#
# Cara 2 — kubectl create secret:
#   kubectl create secret generic backend-siaptes-secret \
#     --namespace backend-siaptes \
#     --from-env-file=.env
#
# Cara 3 — Sealed Secrets (direkomendasikan untuk GitOps):
#   kubeseal --format yaml < 02-secret.yaml > sealed-secret.yaml
#   # sealed-secret.yaml aman untuk di-commit

apiVersion: v1
kind: Secret
metadata:
  name: backend-siaptes-secret
  namespace: backend-siaptes
type: Opaque
stringData:
  # Database (prod_siaptes) — kredensial
  DB_HOST: '192.168.18.181'
  DB_PORT: '3306'
  DB_USER: 'db_user'
  DB_PASSWORD: 'db_password'
  DB_NAME: 'prod_siaptes'

  # JWT
  JWT_SECRET: 'ganti-dengan-random-string-min-32-karakter'

  # Integrasi ICT — HARUS SAMA PERSIS dengan SIAPTES_SERVICE_KEY di .env BE ICT
  ICT_SERVICE_KEY: ''
