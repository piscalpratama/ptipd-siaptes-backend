# App
PORT=3100
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=prod_siaptes

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=8h

# Integrasi ICT — dipakai BE ICT buat memanggil endpoint /integrasi/*
# (endpoint /tes-grup/histori TIDAK pakai key ini, biar kompatibel
#  dengan syncNilaiService.js yang sudah ada di BE ICT tanpa auth header)
ICT_SERVICE_KEY=your_shared_secret_key_for_ict_backend

# CORS — pisah koma kalau lebih dari 1 origin (FE ICT admin + FE Siaptes mahasiswa)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# External API - SALAM Akademik — dipakai buat verifikasi login peserta (level PESERTA).
# Akun ADMIN/SUPERADMIN tetap pakai password lokal di tbs_user, bukan SALAM.
SALAM_API_URL=https://api.uinsgd.ac.id/salam/v2/
